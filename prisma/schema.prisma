generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  roleId              String               @map("role_id")
  status              String               @default("active")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  passwordChangedAt   DateTime?            @map("password_changed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  projectMembers      ProjectMember[]
  refreshTokens       RefreshToken[]
  role                Role                 @relation(fields: [roleId], references: [id])

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  replacedBy String?  @map("replaced_by")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Project {
  id                       String                        @id @default(uuid())
  name                     String
  code                     String                        @unique
  status                   String                        @default("planned")
  createdAt                DateTime                      @default(now()) @map("created_at")
  endDate                  DateTime?                     @map("end_date") @db.Date
  startDate                DateTime?                     @map("start_date") @db.Date
  amendments               Amendment[]
  bankGuarantees           BankGuarantee[]
  bridgeCrossings          BridgeCrossing[]
  budgets                  Budget[]
  constructionSnapshots    ConstructionSnapshot[]
  delays                   Delay[]
  ehsIncidents             EhsIncident[]
  ehsInspections           EhsInspection[]
  houseConnectionClusters  HouseConnectionCluster[]
  ipcs                     Ipc[]
  methodStatements         MethodStatement[]
  paymentTrackingItems     PaymentTrackingItem[]
  financialSummaryCards FinancialSummaryCard[]
  periodicReports          PeriodicReport[]
  pipelineSections         PipelineSection[]
  members                  ProjectMember[]
  reports                  Report[]
  resources                Resource[]
  risks                    Risk[]
  testingActivities        TestingActivity[]
  valveChamberSummary      ValveChamberSummary?
  workPackages             WorkPackage[]
  hdpePipeStocks           HdpePipeStock[]
  equipmentDeployments     EquipmentDeployment[]
  workforceEmployers       WorkforceEmployer[]
  nonConformities          NonConformity[]
  correctiveActions        CorrectiveAction[]
  riskDelaySummary         RiskDelaySummary?
  ehsComplianceSummary     EhsComplianceSummary?
  ehsIncidentSummaryItems  EhsIncidentSummaryItem[]
  ehsNonConformityItems    EhsNonConformitySummaryItem[]
  ehsResourceConsumptions  EhsResourceConsumption[]

  // --------------------------------------------------------------------
  // Construction Progress module — Area-wise / Pipe Diameter Wise /
  // Activity Wise Progress tables + Pipeline & House Connection KPI
  // card summary overrides. Added to give these tables/cards the same
  // persistent Add/Edit/Delete/Update support as Testing Activities,
  // Bridge Crossings and Valve Chamber Summary already have.
  // --------------------------------------------------------------------
  areaWiseProgress         AreaWiseProgress[]
  pipeDiameterProgress     PipeDiameterProgress[]
  activityWiseProgress     ActivityWiseProgress[]
  pipelineProgressSummary  PipelineProgressSummary?
  houseConnectionSummary   HouseConnectionSummary?

  @@map("projects")
}

model ProjectMember {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  userId        String   @map("user_id")
  roleOnProject String   @map("role_on_project")
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model WorkPackage {
  id              String          @id @default(uuid())
  projectId       String          @map("project_id")
  name            String
  plannedStart    DateTime        @map("planned_start") @db.Date
  plannedEnd      DateTime        @map("planned_end") @db.Date
  actualStart     DateTime?       @map("actual_start") @db.Date
  actualEnd       DateTime?       @map("actual_end") @db.Date
  weightagePct    Decimal         @map("weightage_pct") @db.Decimal(5, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  delays          Delay[]
  progressEntries ProgressEntry[]
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("work_packages")
}

model ProgressEntry {
  id                  String      @id @default(uuid())
  workPackageId       String      @map("work_package_id")
  reportedDate        DateTime    @map("reported_date") @db.Date
  physicalProgressPct Decimal     @map("physical_progress_pct") @db.Decimal(5, 2)
  remarks             String?
  attachmentIds       Json?       @map("attachment_ids")
  reportedBy          String      @map("reported_by")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  workPackage         WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@unique([workPackageId, reportedDate])
  @@index([workPackageId])
  @@map("progress_entries")
}

model PipelineSection {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  zone         String
  chainageFrom String   @map("chainage_from")
  chainageTo   String   @map("chainage_to")
  diameter     String
  lengthKm     Decimal  @map("length_km") @db.Decimal(8, 2)
  layingPct    Decimal  @map("laying_pct") @db.Decimal(5, 2)
  testingPct   Decimal  @map("testing_pct") @db.Decimal(5, 2)
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("pipeline_sections")
}

model HouseConnectionCluster {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  clusterName String   @map("cluster_name")
  planned     Int
  completed   Int
  inProgress  Int      @map("in_progress")
  remaining   Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("house_connection_clusters")
}

model TestingActivity {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  activityName String   @map("activity_name")
  plannedValue Decimal  @map("planned_value") @db.Decimal(8, 2)
  actualValue  Decimal  @map("actual_value") @db.Decimal(8, 2)
  unit         String
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("testing_activities")
}

model ValveChamberSummary {
  id         String   @id @default(uuid())
  projectId  String   @unique @map("project_id")
  planned    Int
  completed  Int
  inProgress Int      @map("in_progress")
  notStarted Int      @map("not_started")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("valve_chamber_summaries")
}

model BridgeCrossing {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  crossingName String   @map("crossing_name")
  crossingType String   @map("crossing_type")
  method       String
  status       String
  remarks      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("bridge_crossings")
}

model ConstructionSnapshot {
  id                        String   @id @default(uuid())
  projectId                 String   @map("project_id")
  snapshotDate              DateTime @map("snapshot_date") @db.Date
  pipelineLaidKm            Decimal  @map("pipeline_laid_km") @db.Decimal(8, 2)
  pipelineTestedKm          Decimal  @map("pipeline_tested_km") @db.Decimal(8, 2)
  houseConnectionsCompleted Int      @map("house_connections_completed")
  createdBy                 String   @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("construction_snapshots")
}

model Budget {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  category        String
  fiscalYear      Int       @map("fiscal_year")
  allocatedAmount Decimal   @map("allocated_amount") @db.Decimal(18, 2)
  currency        String    @default("INR")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices        Invoice[]

  @@unique([projectId, category, fiscalYear])
  @@index([projectId])
  @@map("budgets")
}

model Invoice {
  id            String    @id @default(uuid())
  budgetId      String    @map("budget_id")
  invoiceNumber String    @map("invoice_number")
  vendorName    String    @map("vendor_name")
  amount        Decimal   @db.Decimal(18, 2)
  invoiceDate   DateTime  @map("invoice_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  status        String    @default("pending")
  paymentDate   DateTime? @map("payment_date") @db.Date
  attachmentIds Json?     @map("attachment_ids")
  submittedBy   String    @map("submitted_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, invoiceNumber])
  @@index([budgetId])
  @@map("invoices")
}

model EhsIncident {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  incidentType String   @map("incident_type")
  severity     String
  incidentDate DateTime @map("incident_date") @db.Date
  description  String
  status       String   @default("open")
  reportedBy   String   @map("reported_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ehs_incidents")
}

model EhsInspection {
  id             String             @id @default(uuid())
  projectId      String             @map("project_id")
  inspectionDate DateTime           @map("inspection_date") @db.Date
  scorePct       Decimal?           @map("score_pct") @db.Decimal(5, 2)
  remarks        String?
  inspectedBy    String             @map("inspected_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  checklistItems EhsChecklistItem[]
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ehs_inspections")
}

model EhsChecklistItem {
  id              String        @id @default(uuid())
  inspectionId    String        @map("inspection_id")
  itemDescription String        @map("item_description")
  status          String
  dueDate         DateTime?     @map("due_date") @db.Date
  inspection      EhsInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("ehs_checklist_items")
}

model Risk {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  category       String
  description    String
  probability    String
  impact         String
  status         String   @default("open")
  ownerId        String   @map("owner_id")
  identifiedDate DateTime @map("identified_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ownerName      String?  @map("owner_name")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("risks")
}

model Delay {
  id             String       @id @default(uuid())
  projectId      String       @map("project_id")
  workPackageId  String?      @map("work_package_id")
  reason         String
  daysDelayed    Int          @map("days_delayed")
  rootCause      String?      @map("root_cause")
  mitigationPlan String?      @map("mitigation_plan")
  reportedBy     String       @map("reported_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  category       String       @default("General")
  status         String       @default("open")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage    WorkPackage? @relation(fields: [workPackageId], references: [id])

  @@index([projectId])
  @@index([workPackageId])
  @@map("delays")
}

model Resource {
  id            String       @id @default(uuid())
  projectId     String       @map("project_id")
  name          String
  type          String
  unit          String
  totalCapacity Decimal      @map("total_capacity") @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  allocations   Allocation[]
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([type])
  @@map("resources")
}

model Allocation {
  id             String   @id @default(uuid())
  resourceId     String   @map("resource_id")
  workPackageId  String?  @map("work_package_id")
  quantity       Decimal  @db.Decimal(18, 2)
  allocationDate DateTime @map("allocation_date") @db.Date
  status         String   @default("planned")
  remarks        String?
  allocatedBy    String   @map("allocated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  resource       Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, workPackageId, allocationDate])
  @@index([resourceId])
  @@index([workPackageId])
  @@index([status])
  @@map("allocations")
}

model Report {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  title         String
  period        String
  module        String    @default("overall")
  dateFrom      DateTime? @map("date_from") @db.Date
  dateTo        DateTime? @map("date_to") @db.Date
  generatedDate DateTime  @map("generated_date") @db.Date
  status        String    @default("draft")
  summary       String?
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([module])
  @@index([status])
  @@map("reports")
}

model PeriodicReport {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  document    String
  latestIssue String?   @map("latest_issue")
  status      String    @default("pending")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("periodic_reports")
}

model Ipc {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  projectId    String    @map("project_id")
  ipc          String
  ipcDate      DateTime? @map("ipc_date") @db.Date
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  aceStatus    String?   @map("ace_status")
  aoaAmount    Decimal?  @map("aoa_amount") @db.Decimal(18, 2)
  clientStatus String?   @map("client_status")
  percentage   Decimal?  @db.Decimal(5, 2)
  period       String?
  usdAmount    Decimal?  @map("usd_amount") @db.Decimal(18, 2)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ipc])
  @@index([projectId])
  @@index([status])
  @@map("ipcs")
}

model Amendment {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  projectId     String    @map("project_id")
  amendment     String
  subject       String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  amendmentDate DateTime? @map("amendment_date") @db.Date
  scope         String?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("amendments")
}

model BankGuarantee {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  projectId  String    @map("project_id")
  guarantee  String
  bank       String
  usdAmount  Decimal   @map("usd_amount") @db.Decimal(18, 2)
  validUntil DateTime? @map("valid_until") @db.Date
  status     String    @default("valid")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("bank_guarantees")
}

model FinancialSummaryCard {
  id             String    @id @default(uuid())
  projectId      String
  cardKey        String
  valuePrimary   Decimal?  @db.Decimal(18, 4)
  valueSecondary Decimal?  @db.Decimal(18, 4)
  valueText      String?
  subText        String?
  noteText       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project        Project   @relation(fields: [projectId], references: [id])

  @@unique([projectId, cardKey])
}

model PaymentTrackingItem {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  description   String
  amountAoa     Decimal?  @map("amount_aoa") @db.Decimal(18, 2)
  amountUsd     Decimal?  @map("amount_usd") @db.Decimal(18, 2)
  isHighlighted Boolean   @default(false) @map("is_highlighted")
  sortOrder     Int       @default(0) @map("sort_order")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("payment_tracking_items")
}

model MethodStatement {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  methodStatement String    @map("method_statement")
  statementDate   DateTime? @map("statement_date") @db.Date
  status          String    @default("pending")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("method_statements")
}

// -----------------------------------------------------------------------
// Construction Progress module — Area-wise Progress / Pipe Diameter Wise
// Progress / Activity Wise Progress tables, plus Pipeline & House
// Connection KPI-card summary overrides. All support full Add / Edit /
// Delete (soft delete via deletedAt, same pattern as the Resource
// Dashboard's HDPE Pipe Stock / Equipment Deployment tables) so that
// edits made on the module persist across reloads.
// -----------------------------------------------------------------------

model AreaWiseProgress {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  area         String
  designReport Decimal   @map("design_report_m") @db.Decimal(12, 2)
  contract     Decimal   @map("contract_m") @db.Decimal(12, 2)
  executed     Decimal   @map("executed_m") @db.Decimal(12, 2)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("area_wise_progress")
}

model PipeDiameterProgress {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  diameter       String
  proposedLength Decimal   @map("proposed_length_m") @db.Decimal(12, 2)
  executed       Decimal   @map("executed_m") @db.Decimal(12, 2)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("pipe_diameter_progress")
}

model ActivityWiseProgress {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  activity      String
  previousMonth Decimal?  @map("previous_month") @db.Decimal(12, 2)
  currentMonth  Decimal?  @map("current_month") @db.Decimal(12, 2)
  cumulative    Decimal?  @db.Decimal(12, 2)
  totalPercent  Decimal?  @map("total_percent") @db.Decimal(5, 2)
  unit          String?
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("activity_wise_progress")
}

model PipelineProgressSummary {
  id            String   @id @default(uuid())
  projectId     String   @unique @map("project_id")
  totalLengthKm Decimal  @map("total_length_km") @db.Decimal(10, 3)
  laidKm        Decimal  @map("laid_km") @db.Decimal(10, 3)
  hydroTestedKm Decimal  @map("hydro_tested_km") @db.Decimal(10, 3)
  updatedAt     DateTime @updatedAt @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("pipeline_progress_summaries")
}

model HouseConnectionSummary {
  id         String   @id @default(uuid())
  projectId  String   @unique @map("project_id")
  completed  Int
  inProgress Int      @map("in_progress")
  remaining  Int
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("house_connection_summaries")
}

// -----------------------------------------------------------------------
// Resource Dashboard - reporting tables (formerly hardcoded on the frontend)
// Added to give the Resource Dashboard's HDPE Pipe Stock, Equipment
// Deployment, and Workforce By Employer tables the same persistent
// Add/Edit/Delete/Update support that the Resource table already has.
// -----------------------------------------------------------------------

model HdpePipeStock {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  diameter   String
  receivedM  Decimal   @map("received_m") @db.Decimal(12, 2)
  usedM      Decimal   @map("used_m") @db.Decimal(12, 2)
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, diameter])
  @@index([projectId])
  @@map("hdpe_pipe_stocks")
}

model EquipmentDeployment {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  category   String
  planned    Decimal?  @db.Decimal(12, 2)
  deployed   Decimal   @db.Decimal(12, 2)
  remarks    String?
  isTotal    Boolean   @default(false) @map("is_total")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("equipment_deployments")
}

model WorkforceEmployer {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  groupName  String?   @map("group_name")
  category   String?
  headcount  Int
  isTotal    Boolean   @default(false) @map("is_total")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("workforce_employers")
}

// -----------------------------------------------------------------------
// Risk & Delay Dashboard - Non-Conformity Register and Corrective Actions
// Tracker. Added to give these two tables the same persistent
// Add/Edit/Delete support that Risk and Delay already have, plus a
// RiskDelaySummary table to optionally override the 4 KPI summary cards
// (Projected Slippage, Open Delay Items, Mitigated This Quarter,
// On Critical Path) instead of always auto-calculating them from Delay
// records. A null field means "keep auto-calculating this card".
// -----------------------------------------------------------------------

model NonConformity {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  description String
  owner       String
  status      String    @default("open")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("non_conformities")
}

model CorrectiveAction {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  action     String
  owner      String
  status     String    @default("pending")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("corrective_actions")
}

model RiskDelaySummary {
  id                    String   @id @default(uuid())
  projectId             String   @unique @map("project_id")
  projectedSlippageDays Int?     @map("projected_slippage_days")
  openDelayItems        Int?     @map("open_delay_items")
  mitigatedThisQuarter  Int?     @map("mitigated_this_quarter")
  onCriticalPath        Int?     @map("on_critical_path")
  updatedAt             DateTime @updatedAt @map("updated_at")
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risk_delay_summaries")
}

// -----------------------------------------------------------------------
// EHS Dashboard - Compliance card overrides, Incident/Non-Conformity
// summary registers, and Resource Consumption detail.
//
// EhsComplianceSummary mirrors the RiskDelaySummary "override" pattern:
// a null field means "keep auto-calculating this card" (e.g. Open
// Incidents auto-counts from EhsIncident where status='open' unless
// openIncidentsOverride is set), while the 5 plan/compliance percentages
// have no other source of truth so they are simply editable values.
//
// EhsIncidentSummaryItem / EhsNonConformitySummaryItem replace the old
// single hardcoded "Incidents & Non-Conformities" table with two
// independently CRUD-able registers, both sharing the same
// Type / Count / Details / Status shape.
// -----------------------------------------------------------------------

model EhsComplianceSummary {
  id                      String   @id @default(uuid())
  projectId               String   @unique @map("project_id")
  overallEshsPct          Decimal? @map("overall_eshs_pct") @db.Decimal(5, 2)
  pgasEsmpPct             Decimal? @map("pgas_esmp_pct") @db.Decimal(5, 2)
  healthSafetyPlanPct     Decimal? @map("health_safety_plan_pct") @db.Decimal(5, 2)
  siteManagementPlanPct   Decimal? @map("site_management_plan_pct") @db.Decimal(5, 2)
  methodStatementsPct     Decimal? @map("method_statements_pct") @db.Decimal(5, 2)
  openIncidentsOverride   Int?     @map("open_incidents_override")
  openIncidentsNote       String?  @map("open_incidents_note")
  toolboxTalks30dOverride Int?     @map("toolbox_talks_30d_override")
  toolboxTalks30dNote     String?  @map("toolbox_talks_30d_note")
  updatedBy               String?  @map("updated_by")
  updatedAt               DateTime @updatedAt @map("updated_at")
  project                  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ehs_compliance_summaries")
}

model EhsIncidentSummaryItem {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  type       String
  count      Int       @default(0)
  details    String?
  status     String    @default("open")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ehs_incident_summary_items")
}

model EhsNonConformitySummaryItem {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  type       String
  count      Int       @default(0)
  details    String?
  status     String    @default("open")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ehs_nonconformity_summary_items")
}

model EhsResourceConsumption {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  resourceName        String    @map("resource_name")
  unit                String?
  previousPeriodLabel String    @map("previous_period_label")
  previousValue       Decimal   @map("previous_value") @db.Decimal(14, 2)
  currentPeriodLabel  String    @map("current_period_label")
  currentValue        Decimal   @map("current_value") @db.Decimal(14, 2)
  sortOrder           Int       @default(0) @map("sort_order")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ehs_resource_consumptions")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  module      String
  referenceId String?  @map("reference_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module, referenceId])
  @@map("audit_logs")
}
