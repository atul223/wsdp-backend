# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/water_supply_monitoring?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# Security
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRY_MIN=30

# Seed script (bootstrap admin — change immediately after first login)
SEED_ADMIN_EMAIL=admin@watersupply-monitor.example
SEED_ADMIN_PASSWORD=ChangeMe123!
